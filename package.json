{
  "name": "nyvex",
  "version": "1.0.0",
  "description": "NYVEX — локальный AI-чат (PWA + Capacitor APK)",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npx --yes serve -l 5173 .",
    "cap:init": "npx --yes @capacitor/cli init NYVEX com.nyvex.app --web-dir .",
    "cap:add:android": "npx --yes @capacitor/cli add android",
    "cap:sync": "npx --yes @capacitor/cli sync",
    "cap:open:android": "npx --yes @capacitor/cli open android",
    "build:apk": "cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0"
  },
  "license": "MIT"
}
